APP_NAME="ClickUp Telegram Notifier"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Tehran

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# App / cron
# Cron URLs use this token: /cron/...?token=CRON_TOKEN
CRON_TOKEN=
# Team and calendar are Tehran-based (Jalali months, Saturday-Friday weeks)
APP_TIMEZONE=Asia/Tehran

# Team identity (members, GitHub logins, admin) lives in the team_members table.
# Seed it with: php artisan db:seed --class=TeamMemberSeeder --force

# Telegram
# Team group is notification-only. Member actions happen in private chat with the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=
TELEGRAM_MESSAGE_TEMPLATE='{name} تسک "{task}" رو انجام داد ✅'
TELEGRAM_COMMIT_MESSAGE_TEMPLATE="{name} توسعه داد:\n{message}\n#{repo}"
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_ENDPOINT=

# GitHub (commit scoring; the author login is matched to team_members.github_login)
GITHUB_TOKEN=
GITHUB_ORG=BytelabsTeam
GITHUB_REPOS=BytelabsTeam/MegaShop,BytelabsTeam/AdsPlatform,BytelabsTeam/anon-chat-telegram,BytelabsTeam/juli,BytelabsTeam/anon-chat-core,BytelabsTeam/BluPal,BytelabsTeam/premiumANDstars
GITHUB_COMMIT_POLL_LOOKBACK_MINUTES=15
GITHUB_SCORE_LOOKBACK_HOURS=6
GITHUB_COMMIT_POLL_INTERVAL=60

# IranRouter (OpenAI-compatible) — امتیازدهی کامیت
IRANROUTER_API_KEY=
IRANROUTER_BASE_URL=https://www.iranrouter.net/api/v1
IRANROUTER_MODEL=openai/gpt-6-luna
IRANROUTER_TIMEOUT=60
